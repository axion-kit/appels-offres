{
  "name": "kit-modele",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "ia:eval": "tsx src/lib/ia/jeu-d-or/ia-eval.ts",
    "e2e": "playwright test --trace off",
    "vente:verifier": "tsx src/lib/vente/verifier.ts",
    "planche": "tsx src/design/planche-cli.ts",
    "design:check": "vitest run src/lib/design/controle.test.ts",
    "pilotage:pretes": "node .github/scripts/pretes.mjs",
    "pilotage:lint": "node .github/scripts/lint-fiches.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "next": "^15.5.0",
    "pg": "8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": ">=8.5.23 <9",
      "@typescript-eslint/typescript-estree>minimatch": ">=11.0.1 <12"
    }
  }
}
