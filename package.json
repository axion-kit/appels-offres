{
  "name": "kit-modele",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "ia:eval": "tsx src/lib/ia/jeu-d-or/ia-eval.ts",
    "e2e": "playwright test --trace off",
    "vente:verifier": "tsx src/lib/vente/verifier.ts",
    "planche": "tsx src/design/planche-cli.ts",
    "design:check": "vitest run src/lib/design/controle.test.ts",
    "pilotage:pretes": "node .github/scripts/pretes.mjs",
    "pilotage:lint": "node .github/scripts/lint-fiches.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "better-auth": "1.7.18",
    "bullmq": "6.4.2",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "file-type": "22.3.0",
    "ioredis": "6.0.0",
    "mailparser": "3.12.4",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.64.1",
    "@types/mailparser": "3.9.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "6.4.24",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": ">=8.5.23 <9",
      "@typescript-eslint/typescript-estree>minimatch": ">=11.0.1 <12"
    }
  }
}
